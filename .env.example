# Copy to .env and fill in. Never commit .env.
# aiarb does not load .env files itself: export these in your shell, or run
# with `uv run --env-file .env aiarb ...`.

# Used by Claude Code for every role. Not needed if Claude Code is already logged in.
ANTHROPIC_API_KEY=

# Optional: enables Jev for objection scoring. Without it, a language model scores.
TYPESAFE_API_KEY=

# Only for `make publish`: a GitLab token that can write to the package registry,
# such as a deploy token with write_package_registry and read_package_registry.
UV_PUBLISH_USERNAME=
UV_PUBLISH_PASSWORD=
